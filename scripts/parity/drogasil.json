  "tools": {
    "get_medication_info": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "queries": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "default": "catalog",
          "type": "string",
          "enum": [
            "catalog",
            "brazil"
          ]
        }
      },
      "required": [
        "queries"
      ]
    },
    "plan_purchase": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "origin": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "zipcode": {
                  "type": "string",
                  "pattern": "^\\d{5}-?\\d{3}$"
                }
              },
              "required": [
                "zipcode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              },
              "required": [
                "latitude",
                "longitude"
              ],
              "additionalProperties": false
            }
          ],
          "description": "CEP or exact coordinates explicitly supplied for this lookup."
        },
        "expandSearch": {
          "description": "Set true only after the user accepts the offered 25 km search.",
          "type": "boolean"
        },
        "store": {
          "type": "string",
          "const": "nearest"
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "selectedSku": {
                "type": "string",
                "pattern": "^\\d+$"
              },
              "includeGenerics": {
                "type": "boolean"
              },
              "brand": {
                "type": "string",
                "minLength": 1
              },
              "genericOnly": {
                "type": "boolean"
              }
            },
            "required": [
              "query"
            ]
          }
        }
      },
      "required": [
        "origin",
        "items"
      ]
    },
    "search_products": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "query"
      ]
    },
    "get_products": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "skus": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d+$"
          }
        }
      },
      "required": [
        "skus"
      ]
    },
    "find_nearby_stock": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "sku": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "origin": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "zipcode": {
                  "type": "string",
                  "pattern": "^\\d{5}-?\\d{3}$"
                }
              },
              "required": [
                "zipcode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              },
              "required": [
                "latitude",
                "longitude"
              ],
              "additionalProperties": false
            }
          ],
          "description": "CEP or exact coordinates explicitly supplied for this lookup."
        },
        "expandSearch": {
          "description": "Set true only after the user accepts the offered 25 km search.",
          "type": "boolean"
        },
        "store": {
          "type": "string",
          "const": "nearest"
        },
        "minimumQuantity": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sku",
        "origin"
      ]
    },
    "compare_products": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "expandSearch": {
          "description": "Set true only after the user accepts the offered 25 km search.",
          "type": "boolean"
        },
        "includeGenerics": {
          "type": "boolean"
        },
        "origin": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "zipcode": {
                  "type": "string",
                  "pattern": "^\\d{5}-?\\d{3}$"
                }
              },
              "required": [
                "zipcode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              },
              "required": [
                "latitude",
                "longitude"
              ],
              "additionalProperties": false
            }
          ],
          "description": "CEP or exact coordinates explicitly supplied for this lookup."
        },
        "store": {
          "anyOf": [
            {
              "type": "string",
              "const": "nearest"
            },
            {
              "type": "string",
              "pattern": "^\\d+$"
            }
          ]
        }
      },
      "required": [
        "query"
      ]
    },
    "compare_pharmacy_prices": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "zipcode": {
          "type": "string",
          "pattern": "^\\d{5}-?\\d{3}$"
        },
        "includeGenerics": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "query",
        "zipcode"
      ]
    },
    "collect_catalog_snapshot": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "queries": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          }
        },
        "maxItems": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "queries"
      ]
    },
    "read_catalog_snapshot": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "offset": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "runId"
      ]
    }
  }
}
